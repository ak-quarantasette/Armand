---
import Base from '../layouts/Base.astro';
import { pagina } from '../lib/testi';
import { sito, telHref, waHref } from '../data/sito';

const p = pagina('contatti');
const paragrafi = p.intro.filter((b) => b.tipo === 'p');
const wa = waHref();
---
<Base titolo={p.titolo} descrizione={p.descrizione}>
  <section class="contenitore cima">
    <div class="pila">
      <h1>{p.h1}</h1>
      {paragrafi[0]?.tipo === 'p' && <p class="intro" set:html={paragrafi[0].html} />}
    </div>

    <dl class="recapiti">
      {(sito.tel1 || sito.tel2) && (
        <>
          <dt>Telefono</dt>
          <dd>
            {sito.tel1 && <a href={telHref(sito.tel1)}>{sito.tel1}</a>}
            {sito.tel2 && <a href={telHref(sito.tel2)}>{sito.tel2}</a>}
          </dd>
        </>
      )}
      {wa && (<><dt>WhatsApp</dt><dd><a href={wa} rel="noopener">Scrivi su WhatsApp</a></dd></>)}
      {sito.email && (<><dt>Email</dt><dd><a href={`mailto:${sito.email}`}>{sito.email}</a></dd></>)}
      <dt>Sede</dt>
      <dd><span>{sito.comune} ({sito.provincia})</span></dd>
    </dl>

    {paragrafi[1]?.tipo === 'p' && <p class="tenue" set:html={paragrafi[1].html} />}
  </section>
</Base>

<style>
  .cima { display: grid; gap: clamp(28px, 4vw, 48px); padding-block: clamp(28px, 5vw, 64px) clamp(72px, 10vw, 140px); }
  .intro { font-size: clamp(1.15rem, 1.9vw, 1.4rem); line-height: 1.5; max-width: 44ch; }
  .recapiti { display: grid; grid-template-columns: minmax(0, 11rem) minmax(0, 1fr); margin: 0; max-width: 52rem; border-top: 1px solid var(--antracite); }
  .recapiti dt, .recapiti dd { margin: 0; padding: clamp(16px, 2.4vw, 26px) 0; border-bottom: 1px solid var(--linea); }
  .recapiti dt { color: var(--pietra); }
  .recapiti dd { display: grid; gap: 6px; font-family: var(--fd); font-size: clamp(1.35rem, 3.2vw, 2.1rem); line-height: 1.2; overflow-wrap: anywhere; }
  .recapiti a { color: var(--antracite); text-decoration-thickness: 1px; text-decoration-color: var(--linea); }
  .recapiti a:hover { color: var(--accento); text-decoration-color: currentColor; }
  @media (max-width: 560px) {
    .recapiti { grid-template-columns: minmax(0, 1fr); }
    .recapiti dt { padding-bottom: 0; border-bottom: 0; }
    .recapiti dd { padding-top: 6px; }
  }
</style>
