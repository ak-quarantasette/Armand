---
// Pagina Lavori con due viste, come nel riferimento crl-2026.webflow.io/library ("Wheel, List").
// RUOTA (vista iniziale): le foto stanno su un grande cerchio che gira mentre si scorre. Quella in alto al
//   centro è grande e dritta, le vicine più piccole e inclinate; arrivando al centro si ingrandiscono.
//   Accanto: numero, gruppo, titolo e nota della foto al centro. Movimento nello script "ruota" in fondo.
// ELENCO: la galleria da rivista di prima (riferimento spykercars.com), descritta qui sotto.
// Senza JavaScript o con "riduci animazioni" si vede solo l'elenco.
//
// - Foto di misure diverse, alternate a sinistra e a destra e sfalsate in altezza, con didascalie piccole.
// - Le coppie prima/dopo stanno affiancate su tutta la larghezza.
// - In ogni gruppo la prima foto orizzontale è "larga": occupa tutta la larghezza e si allarga entrando.
// - Ogni foto entra "in cornice": parte ritagliata al centro e un po' ingrandita, e mentre si scorre la
//   cornice si apre fino alla foto intera; poi scorre un filo più lenta della pagina (profondità).
//   Il movimento segue lo scorrimento (script in fondo). Senza JavaScript o con "riduci animazioni" le foto
//   sono semplicemente ferme e intere.
import Base from '../layouts/Base.astro';
import Azioni from '../components/Azioni.astro';
import Blocchi from '../components/Blocchi.astro';
import Foto from '../components/Foto.astro';
import { pagina } from '../lib/testi';
import { lavori, foto, type Lavoro } from '../data/foto';

const p = pagina('lavori');
const tutti = lavori();
const gruppi = [...new Set(tutti.map((l) => l.gruppo))];
// nelle coppie prima/dopo il nome del file dice quale foto è quale
const stato = (nome: string) => (nome.endsWith('-prima') ? 'Prima' : nome.endsWith('-dopo') ? 'Dopo' : '');
const orizzontale = (nome: string) => foto(nome).width > foto(nome).height;

// Posto di ogni lavoro nella griglia a 12 colonne (solo su schermi larghi).
type Posto = { lavoro: Lavoro; tipo: 'doppio' | 'larga' | 'singola'; col: string; riga: number; sale: boolean; lato: 'sx' | 'dx' };
function impagina(lista: Lavoro[]): Posto[] {
  const posti: Posto[] = [];
  let larga = false, lato: 'sx' | 'dx' = 'sx', n = 0;
  // ampiezze in colonne: le verticali un po' più strette delle orizzontali, alternate per dare ritmo
  const ampiezzaV = [5, 4, 4, 5], ampiezzaO = [6, 5];
  const inizioSx = [2, 1], fineDx = [12, 11];
  lista.forEach((l, i) => {
    const riga = i + 1;
    if (l.foto.length > 1) { posti.push({ lavoro: l, tipo: 'doppio', col: '1 / -1', riga, sale: false, lato }); return; }
    if (!larga && orizzontale(l.foto[0]) && i > 0) {
      larga = true;
      posti.push({ lavoro: l, tipo: 'larga', col: '1 / -1', riga, sale: false, lato });
      return;
    }
    const prima = posti[posti.length - 1];
    const span = orizzontale(l.foto[0]) ? ampiezzaO[n % 2] : ampiezzaV[n % 4];
    // ogni lato resta nella sua metà (colonne 1-6 e 7-12), così due foto affiancate non si toccano mai
    const inizio = lato === 'sx' ? Math.min(inizioSx[n % 2], 7 - span) : Math.max(7, fineDx[n % 2] - span + 1);
    // sale accanto alla foto precedente se quella era una singola dall'altro lato
    const sale = !!prima && prima.tipo === 'singola' && prima.lato !== lato;
    posti.push({ lavoro: l, tipo: 'singola', col: `${inizio} / span ${span}`, riga, sale, lato });
    lato = lato === 'sx' ? 'dx' : 'sx';
    n++;
  });
  return posti;
}

// Ruota: una carta per foto, nell'ordine della pagina (le coppie prima/dopo diventano due carte di fila).
const carte = tutti.flatMap((l) => l.foto.map((n) => ({ nome: n, titolo: l.titolo, nota: l.didascalia, gruppo: l.gruppo, stato: l.foto.length > 1 ? stato(n) : '', oriz: orizzontale(n) })));
---
<Base titolo={p.titolo} descrizione={p.descrizione}>
  <section class="contenitore cima">
    <h1>{p.h1}</h1>
    <div class="intro"><Blocchi blocchi={p.intro} /></div>
    <div class="viste" role="group" aria-label="Vista">
      <button type="button" data-vista="ruota" aria-pressed="true">Ruota</button>
      <button type="button" data-vista="elenco" aria-pressed="false">Elenco</button>
    </div>
  </section>

  <section class="ruota" aria-label="Lavori, una foto alla volta" style={`--n:${carte.length}`}>
    <div class="palco">
      <div class="anello">
        {carte.map((c, i) => (
          <figure class:list={['carta', { oriz: c.oriz }]} data-i={i} data-titolo={c.titolo} data-nota={c.nota} data-gruppo={c.gruppo} data-stato={c.stato}>
            <Foto nome={c.nome} sizes="(min-width: 900px) 46vw, 80vw" subito={i < 2} />
            <figcaption class="solo-lettori">{c.titolo}{c.stato ? ` (${c.stato.toLowerCase()})` : ''}: <Fragment set:html={c.nota} /></figcaption>
          </figure>
        ))}
      </div>
      <div class="scheda" aria-hidden="true">
        <p class="conta"><span class="ora">01</span><span class="tot"> / {String(carte.length).padStart(2, '0')}</span></p>
        <p class="gruppo-ora">{carte[0].gruppo}</p>
        <p class="titolo-ora">{carte[0].titolo}</p>
        <p class="nota-ora" set:html={carte[0].nota} />
        <p class="prossimo"></p>
      </div>
      <p class="aiuto" aria-hidden="true"><span>Scorri</span><i></i></p>
    </div>
  </section>

  <div class="elenco">
  {gruppi.map((g, gi) => (
    <section class="sezione gruppo">
      <div class="contenitore">
        <header class="testa">
          <p class="etichetta">{String(gi + 1).padStart(2, '0')} · Lavori</p>
          <h2 class="maschera"><span>{g}</span></h2>
        </header>
        <div class="galleria">
          {impagina(tutti.filter((l) => l.gruppo === g)).map((s, i) => (
            <article class:list={['lavoro', s.tipo, s.lato, { sale: s.sale }]} style={`--col:${s.col};--riga:${s.riga}`}>
              <div class="scatti">
                {s.lavoro.foto.map((n) => (
                  <Foto
                    nome={n}
                    classe={['svela', s.tipo === 'larga' ? 'larga' : '', s.tipo === 'doppio' && stato(n) ? stato(n).toLowerCase() : ''].join(' ').trim()}
                    subito={gi === 0 && i === 0}
                    sizes={s.tipo === 'singola' ? '(min-width: 900px) 46vw, 92vw' : s.tipo === 'larga' ? '(min-width: 1340px) 1240px, 94vw' : '(min-width: 900px) 56vw, 92vw'}
                    voci={s.tipo === 'doppio' && stato(n) ? [['Stato', stato(n)]] : []}
                  />
                ))}
              </div>
              <dl class="cartiglio">
                <dt>Lavoro</dt><dd>{s.lavoro.titolo}</dd>
                <dt>Note</dt><dd set:html={s.lavoro.didascalia} />
              </dl>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}
  </div>

  <section class="invito su-scuro">
    <div class="contenitore pila">
      <h2>Hai un lavoro in mente?</h2>
      <p>Raccontacelo: la consulenza è gratuita.</p>
      <Azioni />
    </div>
  </section>
</Base>

<script>
  // RUOTA: le carte stanno su un cerchio di raggio R con il centro sotto lo schermo; scorrendo il cerchio
  // gira. pos = quale carta è in cima (anche frazionaria). Ogni carta ha un angolo (i - pos) * passo:
  // da lì posizione, inclinazione e grandezza (più grande al centro). Viene aggiornata anche la scheda.
  const d = document.documentElement;
  const ruota = document.querySelector<HTMLElement>('.ruota');
  const pulsanti = [...document.querySelectorAll<HTMLButtonElement>('.viste button')];
  if (ruota && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    d.classList.add('ruota-viva');
    const carte = [...ruota.querySelectorAll<HTMLElement>('.carta')];
    const N = carte.length;
    const scheda = {
      ora: ruota.querySelector('.ora')!, gruppo: ruota.querySelector('.gruppo-ora')!, titolo: ruota.querySelector('.titolo-ora')!,
      nota: ruota.querySelector('.nota-ora')!, prossimo: ruota.querySelector('.prossimo')!,
    };
    let attiva = -1, attesa = false;
    const giro = () => {
      attesa = false;
      if (!d.classList.contains('vista-ruota')) return;
      const palco = ruota.querySelector<HTMLElement>('.palco')!;
      const W = palco.clientWidth, H = palco.clientHeight, tel = W < 700;
      const r = ruota.getBoundingClientRect();
      const corsa = Math.max(1, ruota.offsetHeight - H);
      const t = Math.min(1, Math.max(0, (palco.getBoundingClientRect().top - r.top) / corsa));
      const pos = t * (N - 1);
      const R = (tel ? 1.55 : 1.2) * W;
      const passo = Math.asin(Math.min(0.95, ((tel ? 0.8 : 0.4) * W) / R));
      const cy = H * (tel ? 0.4 : 0.46);
      for (let i = 0; i < N; i++) {
        const a = (i - pos) * passo;
        const c = carte[i];
        if (Math.abs(a) > 1.35) { c.style.visibility = 'hidden'; continue; }
        const vicino = Math.min(1, Math.abs(i - pos)); // 0 al centro, 1 dalla carta accanto in poi
        const s = 1 - (tel ? 0.42 : 0.36) * vicino;
        const x = R * Math.sin(a), y = R * (1 - Math.cos(a));
        c.style.visibility = 'visible';
        c.style.transform = `translate3d(calc(-50% + ${x.toFixed(1)}px), calc(-50% + ${(y + cy).toFixed(1)}px), 0) rotate(${((a * 180) / Math.PI * 0.85).toFixed(2)}deg) scale(${s.toFixed(4)})`;
        c.style.zIndex = String(100 - Math.round(Math.abs(i - pos) * 10));
        c.style.opacity = String(Math.max(0, Math.min(1, 1.6 - Math.abs(a) / 1.35 * 1.4)).toFixed(3));
      }
      const k = Math.min(N - 1, Math.max(0, Math.round(pos)));
      if (k !== attiva) {
        attiva = k;
        const c = carte[k].dataset, dopo = carte[k + 1]?.dataset;
        scheda.ora.textContent = String(k + 1).padStart(2, '0');
        scheda.gruppo.textContent = c.gruppo + (c.stato ? ' · ' + c.stato : '');
        scheda.titolo.textContent = c.titolo ?? '';
        scheda.nota.innerHTML = c.nota ?? '';
        scheda.prossimo.textContent = dopo ? `${String(k + 2).padStart(2, '0')}  ${dopo.titolo}${dopo.stato ? ' · ' + dopo.stato : ''}` : '';
        ruota.querySelector('.scheda')!.animate([{ opacity: 0.25, transform: 'translateY(8px)' }, { opacity: 1, transform: 'none' }], { duration: 450, easing: 'cubic-bezier(.22,.61,.36,1)' });
      }
    };
    const chiedi = () => { if (!attesa) { attesa = true; requestAnimationFrame(giro); } };
    const scegli = (vista: string, scorri = false) => {
      d.classList.toggle('vista-ruota', vista === 'ruota');
      d.classList.toggle('vista-elenco', vista === 'elenco');
      pulsanti.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.vista === vista)));
      try { sessionStorage.setItem('am-vista-lavori', vista); } catch (e) {}
      if (scorri) document.querySelector('.viste')!.scrollIntoView({ block: 'start' });
      attiva = -1; chiedi();
      dispatchEvent(new Event('scroll'));
    };
    pulsanti.forEach((b) => b.addEventListener('click', () => scegli(b.dataset.vista!, true)));
    let iniziale = 'ruota';
    try { iniziale = sessionStorage.getItem('am-vista-lavori') || 'ruota'; } catch (e) {}
    scegli(iniziale);
    // Aggancio: quando lo scorrimento si ferma dentro la ruota, si posa con calma sulla foto più vicina.
    let ferma = 0, guidato = false;
    const aggancia = () => {
      if (guidato) { guidato = false; return; }
      if (!d.classList.contains('vista-ruota')) return;
      const palco = ruota.querySelector<HTMLElement>('.palco')!;
      const r = ruota.getBoundingClientRect();
      const corsa = ruota.offsetHeight - palco.clientHeight;
      if (corsa <= 0) return;
      const fatto = palco.getBoundingClientRect().top - r.top; // quanto della ruota è già stato percorso
      const t = fatto / corsa;
      if (t <= 0.0005 || t >= 0.9995) return; // prima o dopo la ruota: niente aggancio
      const k = Math.round(t * (N - 1));
      const meta = scrollY + ((k / (N - 1)) * corsa - fatto);
      if (Math.abs(meta - scrollY) > 2) { guidato = true; scrollTo({ top: meta, behavior: 'smooth' }); }
    };
    addEventListener('scroll', () => { chiedi(); clearTimeout(ferma); ferma = window.setTimeout(aggancia, 160); }, { passive: true });
    addEventListener('resize', chiedi, { passive: true });
  }
</script>

<script>
  // Cornice che si apre e profondità, legate allo scorrimento. Lavora solo sulle foto vicine allo schermo.
  // Scrive due numeri su ogni foto: --apri (1 = chiusa, 0 = aperta) e --sposta (da -1 a 1, posizione
  // rispetto al centro dello schermo). Il resto lo fa il CSS qui sotto.
  const d = document.documentElement;
  if (d.classList.contains('moto')) {
    const foto = [...document.querySelectorAll<HTMLElement>('.galleria .svela')];
    const vicine = new Set<HTMLElement>();
    const morbido = (t: number) => 1 - Math.pow(1 - t, 3);
    let attesa = false;
    const giro = () => {
      attesa = false;
      const H = innerHeight;
      for (const f of vicine) {
        const r = (f.querySelector('picture') ?? f).getBoundingClientRect();
        const corsa = H * (f.classList.contains('larga') ? 0.85 : 0.6); // quanto scorrere per aprirla tutta
        const p = Math.min(1, Math.max(0, (H - r.top) / corsa));
        const q = Math.max(-1, Math.min(1, (r.top + r.height / 2 - H / 2) / H));
        f.style.setProperty('--apri', (1 - morbido(p)).toFixed(4));
        f.style.setProperty('--sposta', q.toFixed(4));
      }
    };
    const chiedi = () => { if (!attesa) { attesa = true; requestAnimationFrame(giro); } };
    const io = new IntersectionObserver((voci) => {
      for (const v of voci) {
        const f = v.target as HTMLElement;
        if (v.isIntersecting) vicine.add(f);
        else {
          vicine.delete(f);
          // passata sopra lo schermo: resta aperta
          if (v.boundingClientRect.bottom < 0) f.style.setProperty('--apri', '0');
        }
      }
      chiedi();
    }, { rootMargin: '25% 0px' });
    foto.forEach((f) => io.observe(f));
    addEventListener('scroll', chiedi, { passive: true });
    addEventListener('resize', chiedi, { passive: true });
    d.classList.add('galleria-viva');
  }
</script>

<style>
  /* Scelta della vista: c'è solo se la ruota può funzionare */
  .viste { display: none; gap: 4px; margin-top: 6px; }
  :global(html.ruota-viva) .viste { display: flex; }
  .viste button { font: 500 0.82rem/1 var(--ft); letter-spacing: 0.14em; text-transform: uppercase; padding: 10px 14px; border: 1px solid var(--linea); background: none; color: var(--pietra); cursor: pointer; }
  .viste button[aria-pressed='true'] { border-color: var(--antracite); color: var(--antracite); }

  /* RUOTA. Lunghezza della sezione = quanto si scorre: un passo per foto. */
  .ruota { display: none; position: relative; height: calc((var(--n) - 1) * 34vh + 100svh - var(--testata)); }
  :global(html.ruota-viva.vista-ruota) .ruota { display: block; }
  :global(html.ruota-viva.vista-ruota) .elenco { display: none; }
  .palco { position: sticky; top: var(--testata); height: calc(100svh - var(--testata)); overflow: hidden; }
  .anello { position: absolute; inset: 0; }
  .carta { --alta: min(60vh, 600px); position: absolute; left: 50%; top: 0; margin: 0; width: calc(var(--alta) * 0.75); padding: 8px; background: #fff; box-shadow: 0 22px 50px -24px rgba(44, 36, 30, 0.5); will-change: transform; visibility: hidden; }
  .carta.oriz { width: min(calc(var(--alta) * 0.8 * 4 / 3), 52vw); }
  .carta :global(.foto img) { aspect-ratio: 3 / 4; object-fit: cover; }
  .carta.oriz :global(.foto img) { aspect-ratio: 4 / 3; }
  .scheda { position: absolute; left: var(--bordo); right: var(--bordo); bottom: clamp(18px, 4vh, 40px); display: grid; grid-template-columns: auto minmax(0, 1fr) auto; grid-template-areas: 'conta gruppo prossimo' 'conta titolo prossimo' 'conta nota prossimo'; column-gap: clamp(16px, 3vw, 48px); align-items: end; z-index: 200; pointer-events: none; }
  .conta { grid-area: conta; font-family: var(--fd); font-size: clamp(2.6rem, 5vw, 4.4rem); line-height: 0.9; color: var(--accento); }
  .conta .tot { font-family: var(--ft); font-size: 0.85rem; color: var(--pietra); letter-spacing: 0.1em; }
  .gruppo-ora { grid-area: gruppo; font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--pietra); }
  .titolo-ora { grid-area: titolo; font-family: var(--fd); font-size: clamp(1.5rem, 2.6vw, 2.3rem); line-height: 1.1; }
  .nota-ora { grid-area: nota; font-size: 0.9rem; color: var(--pietra); max-width: 52ch; }
  .prossimo { grid-area: prossimo; font-size: 0.82rem; color: var(--pietra); max-width: 22ch; text-align: right; }
  .aiuto { position: absolute; right: clamp(14px, 2.4vw, 32px); top: 50%; display: grid; justify-items: center; gap: 10px; font-size: 0.7rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--pietra); transform: translateY(-50%); z-index: 200; }
  .aiuto span { writing-mode: vertical-rl; }
  .aiuto i { width: 1px; height: 44px; background: var(--linea); position: relative; overflow: hidden; }
  .aiuto i::after { content: ''; position: absolute; left: 0; top: 0; width: 1px; height: 18px; background: var(--accento); animation: ruota-filo 1.6s cubic-bezier(0.6, 0, 0.3, 1) infinite; }
  @keyframes ruota-filo { from { transform: translateY(-20px); } to { transform: translateY(46px); } }
  .solo-lettori { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  @media (max-width: 899px) {
    .ruota { height: calc((var(--n) - 1) * 30vh + 100svh - var(--testata) - 60px); }
    .palco { height: calc(100svh - var(--testata) - 60px); }
    .carta { --alta: min(52vh, 92vw); }
    .carta.oriz { width: min(calc(var(--alta) * 0.8 * 4 / 3), 86vw); }
    .scheda { grid-template-columns: auto minmax(0, 1fr); grid-template-areas: 'conta gruppo' 'conta titolo' 'nota nota'; bottom: 14px; row-gap: 4px; }
    .prossimo, .aiuto { display: none; }
    .nota-ora { font-size: 0.84rem; }
  }

  .cima { display: grid; gap: 22px; padding-block: clamp(28px, 5vw, 64px) clamp(36px, 5vw, 64px); }
  .intro :global(p) { font-size: clamp(1.15rem, 1.9vw, 1.4rem); line-height: 1.5; max-width: 46ch; }

  .gruppo + .gruppo { border-top: 0; }
  .testa { display: grid; gap: 14px; margin-bottom: clamp(36px, 6vw, 96px); }
  .etichetta { font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--pietra); }

  /* Galleria: su schermi larghi 12 colonne, ogni lavoro nella sua riga e al suo posto */
  .galleria { --sale: clamp(80px, 15vw, 240px); display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(16px, 2.5vw, 36px); row-gap: clamp(56px, 8vw, 120px); align-items: start; }
  .lavoro { min-width: 0; grid-column: var(--col); grid-row: var(--riga); }
  .lavoro.sale { margin-top: calc(-1 * var(--sale)); }
  .doppio .scatti { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(14px, 3vw, 40px); align-items: end; }
  .doppio .cartiglio { max-width: 36rem; }

  /* didascalie piccole e leggere, come in una rivista */
  .lavoro .cartiglio { font-size: 0.8rem; gap: 1px 14px; margin-top: 10px; padding-top: 8px; border-top-color: var(--linea); max-width: 34rem; }
  .lavoro .cartiglio dd { color: var(--pietra); }
  .lavoro .cartiglio dd:first-of-type { color: var(--antracite); }
  .lavoro :global(.foto .cartiglio) { border-top-color: var(--linea); }

  /* Cornice che si apre: solo se lo script è partito (html.galleria-viva). La foto si apre dal centro;
     quella larga si apre dai lati, come una fascia che si allarga. */
  :global(html.galleria-viva) .lavoro :global(.svela picture) { display: block; overflow: hidden; clip-path: inset(calc(var(--apri, 1) * 20%)); will-change: clip-path; }
  :global(html.galleria-viva) .lavoro :global(.svela.larga picture) { clip-path: inset(calc(var(--apri, 1) * 6%) calc(var(--apri, 1) * 18%)); }
  :global(html.galleria-viva) .lavoro :global(.svela img) { transform: translate3d(0, calc(var(--sposta, 0) * 4%), 0) scale(calc(1.08 + var(--apri, 1) * 0.12)); transform-origin: 50% 50%; will-change: transform; }

  .invito { background: var(--ardesia); color: var(--su-scuro); padding-block: clamp(56px, 8vw, 104px); }
  .invito p { font-size: 1.15rem; color: var(--su-scuro-2); }

  /* Telefono e tablet: una colonna, ma con larghezze alternate per non perdere il ritmo */
  @media (max-width: 899px) {
    .galleria { grid-template-columns: minmax(0, 1fr); row-gap: clamp(44px, 10vw, 72px); }
    .lavoro { grid-column: 1; grid-row: auto; }
    .lavoro.sale { margin-top: 0; }
    .singola.dx { width: 84%; margin-left: auto; }
    .singola.sx { width: 92%; }
  }
  @media (max-width: 560px) {
    .doppio .scatti { grid-template-columns: minmax(0, 1fr); }
    .doppio .scatti :global(.prima) { max-width: 70%; }
  }
</style>
