---
// Struttura comune a tutte le pagine: testa (titolo, descrizione, dati per Google), intestazione, piede, apertura.
import '@fontsource/marcellus/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Intestazione from '../components/Intestazione.astro';
import Piede from '../components/Piede.astro';
import Apertura from '../components/Apertura.astro';
import { sito, zone, telHref, waHref } from '../data/sito';
import { foto } from '../data/foto';
import { u } from '../lib/percorsi';

interface Props { titolo: string; descrizione: string; indicizza?: boolean; }
const { titolo, descrizione, indicizza = true } = Astro.props;
// Gli indirizzi completi si possono scrivere solo quando si sa dove sta il sito (dominio o anteprima nota).
const assoluto = (percorso: string) => (sito.origine ? new URL(percorso, sito.origine).href : '');
const canonico = assoluto(Astro.url.pathname);
const copertina = await getImage({ src: foto('facciata-dopo'), width: 1200, height: 630, format: 'jpg', fit: 'cover' });
const copertinaUrl = assoluto(copertina.src) || copertina.src;
const tel = telHref(sito.tel1) || u('/contatti/');
const wa = waHref() || u('/contatti/');

const scheda = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  name: sito.nome,
  ...(sito.origine ? { url: assoluto(u('/')), image: copertinaUrl } : {}),
  foundingDate: String(sito.dal),
  ...(sito.tel1 ? { telephone: sito.tel1 } : {}),
  ...(sito.email ? { email: sito.email } : {}),
  ...(sito.piva ? { vatID: 'IT' + sito.piva } : {}),
  address: { '@type': 'PostalAddress', addressLocality: sito.comune, addressRegion: sito.provincia, postalCode: sito.cap, addressCountry: 'IT' },
  areaServed: [sito.comune, ...zone].map((n) => ({ '@type': 'City', name: n })),
};
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titolo}</title>
    <meta name="description" content={descrizione} />
    {/* In anteprima (dominio non ancora scritto in astro.config.mjs) nessuna pagina va su Google. */}
    {!sito.anteprima && <link rel="canonical" href={canonico} />}
    {(!indicizza || sito.anteprima) && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#F1F5F8" />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content={sito.nome} />
    <meta property="og:title" content={titolo} />
    <meta property="og:description" content={descrizione} />
    {canonico && <meta property="og:url" content={canonico} />}
    <meta property="og:image" content={copertinaUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(scheda)} />
    <script is:inline>
      // Colori che cambiano scorrendo. Quattro toni, uno per tappa della guida, dal bianco freddo al caldo.
      // Il colore sfuma in modo continuo: è esattamente quello della tappa quando il segno della guida ci
      // arriva sopra (inizio, un terzo, due terzi, fine) e nel mezzo è la miscela dei due vicini.
      // Sulla home il percorso è il blocco ".racconto", lo stesso che muove la guida; nelle altre pagine è
      // tutta la pagina. Per ritoccare i toni si cambia la tabella.
      (function () {
        var d = document.documentElement, attesa = false;
        //            sfondo     superfici  fasce      filetti    testi secondari
        var toni = [['F1F5F8', 'F9FBFC', 'E3EAEF', 'C5CFD6', '525A61'],   // Sopralluogo: bianco freddo
                    ['F6F2EA', 'FCFAF5', 'EBE5D8', 'D6CEBE', '57564E'],   // Preventivo: avorio
                    ['F0DEC4', 'F7EAD6', 'E6CFAE', 'CDB48E', '54483B'],   // Cantiere: sabbia
                    ['E7C5A3', 'EFD3B6', 'DFB892', 'C09770', '4C3C2F']];  // Consegna: terra chiara
        var nomi = ['--calce', '--calce-2', '--calce-3', '--linea', '--pietra'];
        var ultimo = '';
        function n(h, k) { return parseInt(h.substr(k * 2, 2), 16); }
        function aggiorna() {
          attesa = false;
          var r = document.querySelector('.racconto'), t;
          if (r) { var q = r.getBoundingClientRect(); t = -q.top / Math.max(1, q.height - innerHeight); }
          else { t = scrollY / Math.max(1, d.scrollHeight - innerHeight); }
          t = Math.min(1, Math.max(0, t));
          var fase = t * 3, a = Math.min(2, Math.floor(fase)), m = fase - a, chiave = fase.toFixed(3);
          if (chiave === ultimo) return;
          ultimo = chiave;
          for (var c = 0; c < nomi.length; c++) {
            var da = toni[a][c], verso = toni[a + 1][c], rgb = [];
            for (var k = 0; k < 3; k++) rgb.push(Math.round(n(da, k) + (n(verso, k) - n(da, k)) * m));
            d.style.setProperty(nomi[c], 'rgb(' + rgb.join(',') + ')');
          }
        }
        function chiedi() { if (!attesa) { attesa = true; requestAnimationFrame(aggiorna); } }
        addEventListener('scroll', chiedi, { passive: true });
        addEventListener('resize', chiedi, { passive: true });
        addEventListener('DOMContentLoaded', chiedi);
        addEventListener('load', chiedi);
      })();
    </script>
    <script is:inline>
      // Comparsa lenta mentre si scorre: "moto" su <html> accende gli effetti (vedi global.css),
      // poi ogni titolo, foto o passo riceve "visto" quando entra nello schermo. Se qualcosa va storto
      // "moto" viene tolta e tutto resta visibile.
      (function () {
        var d = document.documentElement;
        try {
          if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          d.classList.add('moto');
          document.addEventListener('DOMContentLoaded', function () {
            try {
              var io = new IntersectionObserver(function (voci) {
                voci.forEach(function (v) {
                  var soglia = v.target.classList.contains('maschera') ? 0.6 : 0.12;
                  // chi sta sopra lo schermo (pagina aperta a metà) è già passato: si mostra senza aspettare
                  if (v.intersectionRatio >= soglia || v.boundingClientRect.bottom < 0) { v.target.classList.add('visto'); io.unobserve(v.target); }
                });
              }, { threshold: [0.12, 0.6] });
              document.querySelectorAll('.entra, .maschera').forEach(function (e) { io.observe(e); });
            } catch (e) { d.classList.remove('moto'); }
          });
        } catch (e) { d.classList.remove('moto'); }
      })();
    </script>
    <script is:inline>
      // Apertura: decide subito, prima che la pagina compaia, se mostrarla. Una volta per visita, mai se
      // l'utente ha chiesto meno movimento. Su computer (mouse) parte il muro di mattoni; su telefono compare
      // il logo. Poi la schermata con il logo resta ferma e SI ENTRA NEL SITO SCORRENDO: la schermata segue
      // la rotella o il dito e sale via come un sipario. Vanno bene anche un tasto o un tocco.
      (function () {
        try {
          var d = document.documentElement, s = sessionStorage;
          if (s.getItem('am-apertura') || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          s.setItem('am-apertura', '1');
          var pc = matchMedia('(hover: hover) and (pointer: fine)').matches && innerWidth >= 900;
          d.classList.add('apertura', pc ? 'apertura-pc' : 'apertura-tel');

          var pronta = false, dal = 0, salita = 0, y0 = null, molla = 0, finita = false;
          var velo = function () { return document.querySelector('.velo'); };
          var sposta = function (animata) {
            var v = velo(); if (!v) return;
            v.style.transition = animata ? 'transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1)' : 'none';
            v.style.transform = 'translate3d(0,' + -salita + 'px,0)';
          };
          var entra = function () {
            if (finita) return; finita = true;
            salita = innerHeight * 1.05; sposta(true);
            setTimeout(function () {
              d.classList.remove('apertura', 'apertura-pc', 'apertura-tel', 'apertura-pronta');
              removeEventListener('wheel', rotella); removeEventListener('keydown', tasto);
              removeEventListener('touchstart', tocco); removeEventListener('touchmove', dito); removeEventListener('touchend', lascia);
            }, 720);
          };
          var lascia = function () {
            y0 = null;
            if (finita || !pronta) return;
            if (salita > innerHeight * 0.18) entra(); else { salita = 0; sposta(true); }
          };
          var attiva = function () { return pronta && !finita && Date.now() - dal > 500; };
          var rotella = function (e) {
            if (!d.classList.contains('apertura')) return;
            e.preventDefault();
            if (!attiva()) return;
            salita = Math.max(0, salita + e.deltaY * (e.deltaMode === 1 ? 32 : 1)); sposta(false);
            clearTimeout(molla); molla = setTimeout(lascia, 160);
            if (salita > innerHeight * 0.5) entra();
          };
          var tocco = function (e) { if (attiva()) y0 = e.touches[0].clientY + salita; };
          var dito = function (e) {
            if (!d.classList.contains('apertura')) return;
            e.preventDefault();
            if (y0 === null || !attiva()) return;
            salita = Math.max(0, y0 - e.touches[0].clientY); sposta(false);
          };
          var tasto = function (e) {
            if (attiva() && /^(ArrowDown|PageDown| |Spacebar|Enter|End|Escape)$/.test(e.key)) { e.preventDefault(); entra(); }
          };
          addEventListener('wheel', rotella, { passive: false });
          addEventListener('touchstart', tocco, { passive: true });
          addEventListener('touchmove', dito, { passive: false });
          addEventListener('touchend', lascia);
          addEventListener('keydown', tasto);
          // la scritta "Scorri" è un pulsante: un clic o un tocco lì fa entrare lo stesso
          addEventListener('click', function (e) { if (attiva() && e.target.closest && e.target.closest('.velo .indizio')) entra(); });

          // Da questo momento si può entrare. Lo chiama il muro quando ha finito (Apertura.astro).
          window.amPronta = function () {
            if (pronta) return; pronta = true; dal = Date.now();
            d.classList.add('apertura-pronta');
          };
          if (!pc) setTimeout(window.amPronta, 1300);
          // su computer: se il muro non parte entro 4 secondi, o comunque dopo 16, si può entrare lo stesso
          else {
            setTimeout(function () { if (!window.amMuroPartito) window.amPronta(); }, 4000);
            setTimeout(window.amPronta, 16000);
          }
        } catch (e) { document.documentElement.classList.remove('apertura', 'apertura-pc', 'apertura-tel'); }
      })();
    </script>
  </head>
  <body>
    <a class="salta" href="#contenuto">Vai al contenuto</a>
    <Intestazione />
    <main id="contenuto">
      <slot />
    </main>
    <Piede />
    <nav class="barra" aria-label="Contatti rapidi">
      <a href={tel}>Chiama</a>
      <a href={wa} rel={wa.startsWith('http') ? 'noopener' : undefined}>WhatsApp</a>
    </nav>
    <Apertura />
  </body>
</html>

<style>
  .barra { display: none; }
  @media (max-width: 900px) {
    .barra { position: fixed; left: 0; right: 0; bottom: 0; z-index: 50; display: grid; grid-template-columns: 1fr 1fr; padding-bottom: env(safe-area-inset-bottom, 0px); background: var(--ardesia); }
    .barra a { display: grid; place-items: center; min-height: 60px; font-weight: 500; color: var(--su-scuro); text-decoration: none; }
    .barra a:first-child { background: var(--blu); color: #fff; }
  }
</style>
