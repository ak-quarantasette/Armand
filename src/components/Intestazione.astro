---
// Intestazione: voci di menu a sinistra, pulsante Chiama e, in alto a destra, il logo dell'azienda
// che porta alla Home. È l'unico marchio del sito (scelta del cliente).
import logoUrl from '../assets/logo-azienda.svg?url';
import { menu, sito, telHref } from '../data/sito';
import { u, senzaRadice } from '../lib/percorsi';
const tel = telHref(sito.tel1) || u('/contatti/');
const qui = senzaRadice(Astro.url.pathname);
---
<header class="testata">
  <div class="contenitore riga">
    <details class="tendina">
      <summary><span></span><span></span><b>Menu</b></summary>
      <nav aria-label="Menu">
        {menu.map((v) => <a href={u(v.href)}>{v.nome}</a>)}
      </nav>
    </details>
    <nav class="voci" aria-label="Menu principale">
      {menu.map((v) => <a href={u(v.href)} aria-current={qui === v.href ? 'page' : undefined}>{v.nome}</a>)}
    </nav>
    <a class="b1 chiama" href={tel}>Chiama</a>
    <a class="logo" href={u('/')} aria-label="A.M. Costruzioni, pagina iniziale">
      <img src={logoUrl} width="106" height="56" alt="" />
    </a>
  </div>
</header>

<style>
  .testata { position: sticky; top: 0; z-index: 40; background: var(--calce); border-bottom: 1px solid var(--linea); }
  .riga { display: flex; align-items: center; gap: clamp(14px, 2.4vw, 30px); min-height: var(--testata); }
  .voci { display: flex; gap: clamp(16px, 2.2vw, 30px); margin-right: auto; font-size: 0.97rem; }
  .voci a, .tendina nav a { color: var(--antracite); text-decoration: none; padding-block: 6px; border-bottom: 1px solid transparent; }
  .voci a:hover, .voci a[aria-current="page"] { border-bottom-color: var(--antracite); }
  .chiama { min-height: 42px; padding: 8px 20px; }
  .logo { display: block; flex: none; }
  .logo img { height: 56px; width: auto; }
  .tendina { display: none; }

  @media (max-width: 900px) {
    .voci, .chiama { display: none; }
    .logo { margin-left: auto; }
    .logo img { height: 46px; }
    .tendina { display: block; }
    .tendina summary { list-style: none; display: grid; gap: 5px; align-content: center; width: 44px; height: 44px; padding: 0 9px; cursor: pointer; }
    .tendina summary::-webkit-details-marker { display: none; }
    .tendina summary span { height: 2px; background: var(--antracite); }
    .tendina summary b { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .tendina nav { position: absolute; left: 0; right: 0; top: 100%; display: grid; padding: 6px var(--bordo) 18px; background: var(--calce); border-bottom: 1px solid var(--linea); box-shadow: 0 24px 30px -24px rgba(31, 35, 39, 0.35); }
    .tendina nav a { padding: 14px 0; border-bottom: 1px solid var(--linea); font-size: 1.1rem; }
    .tendina nav a:last-child { border-bottom: 0; }
  }
</style>
