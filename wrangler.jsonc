// Cloudflare (Workers, solo file statici): pubblica la cartella dist/ creata da "npm run build".
// Il nome qui sotto deve restare uguale al nome del progetto scelto su Cloudflare.
{
  "name": "armand",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
